// =============================================================================
// nextflow.config
// =============================================================================

manifest {
    nextflowVersion = '25.10.4'
}

// ---------------------------------------------------------------------------
// Default parameters (can be overridden on the CLI with --param value)
// ---------------------------------------------------------------------------
params {
    bam                      = null
    bai                      = "${params.bam}.bai"
    prefix                   = "latest"
    outdir                   = "${projectDir}/results"
    db_dir                   = "${projectDir}/twitcher_db"
    range_extension          = 10
    ref_version              = "hg38"
    ref_url                  = "https://twitcher.it.helsinki.fi/data/hg38/hg38.no_alt.fa.gz"
    ref_fai                  = "${params.ref_url}.fai"
    ref_gzi                  = "${params.ref_url}.gzi"
    annotat_url              = "https://twitcher.it.helsinki.fi/data/hg38/Homo_sapiens.GRCh38.115.ucsc.sorted.gff3.gz"
    masking_url              = "https://twitcher.it.helsinki.fi/data/hg38/hg38.no_alt.masking.sorted.gff3.gz"
    stratif_url              = "https://twitcher.it.helsinki.fi/data/hg38/GRCh38_notgenenotdifficult.bed.gz"
    db_url                   = "https://twitcher.it.helsinki.fi/data/hg38/db"
    chrom                    = null
    chroms_file              = "${projectDir}/chroms.txt"
    full_genome              = false
    download_db              = true
    copy_bam                 = false
}

// ---------------------------------------------------------------------------
// Singularity — pull Docker images and cache them locally
// ---------------------------------------------------------------------------
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${projectDir}/singularity_cache"
    runOptions = ''
}

executor {
    name   = 'local'
    cpus   = 20
    memory = '80 GB'
}

// ---------------------------------------------------------------------------
// Process resource labels
// ---------------------------------------------------------------------------
process {
    // Default for all processes
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: download {
        cpus   = 2
        memory = '4 GB'
        time   = '4 h'      
    }

    withLabel: low_mem {
        cpus   = 4
        memory = '8 GB'
        time   = '2 h'
    }

    withLabel: high_mem {
        cpus   = 15
        memory = '60 GB'
        time   = '12 h'
    }

    withLabel: twitcher {
        cpus   = 10
        memory = '40 GB'
        time   = '24 h'
    }

    withLabel: twb {
        cpus   = 1
        memory = '20 GB'
        time   = '2 h'
    }

    withName: 'SAMTOOLS_INDEX' {
        container = 'docker://quay.io/biocontainers/samtools:1.25--h9dcdb79_0'
    }

    withName: 'TWITCHER_VERSION|TWITCHER_BAM|TWB_PROCESS|TWB_FILTER' {
        container = 'docker://aryashta/twb:v0.8.4'
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    // Run locally with Singularity
    local {
        singularity.enabled = true
        process {
            withLabel: high_mem {
                cpus   = 10
                memory = '40 GB'   // adjust to your workstation
            }
        }
    }
 
    // SLURM HPC cluster (not tested)
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'normal'
            clusterOptions = '--account=my_project'   // edit as needed
        }
        singularity.enabled = true
    }

    // Lightweight smoke-test with tiny data
    test {
        params {
            assembly = "test-data/test_assembly.fa.gz"
            outdir   = "test_results"
        }
        process {
            withLabel: high_mem {
                cpus   = 4
                memory = '8 GB'
                time   = '1 h'
            }
        }
    }
}


// ---------------------------------------------------------------------------
// Execution report / timeline
// ---------------------------------------------------------------------------
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/${params.prefix}_execution_report.html"
}
 
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/${params.prefix}_timeline.html"
}
 
